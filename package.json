{
  "name": "mileway",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @mileway/shared && npm run build -w @mileway/api && npm run build -w @mileway/web",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "dev": "npm run build -w @mileway/shared && concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @mileway/web",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx apps/api/src/server.ts",
    "seed": "node --env-file-if-exists=.env --import tsx apps/api/src/seed/index.ts",
    "typecheck": "npm run build -w @mileway/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests scripts",
    "test": "npm run test:api",
    "test:api": "npm run build -w @mileway/shared && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-mongo.mjs",
    "demo:local": "node scripts/local-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "mongodb-memory-server-core": "^10.4.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "yaml": "^2.8.1"
  }
}
