# Node 22.13+ or 24. From repo root copy to .env and fill both secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/mileway?replicaSet=rs0
JWT_SECRET=
DEMO_SEED_PASSWORD=
# Optional seed domain. All seeded accounts use the supplied DEMO_SEED_PASSWORD.
DEMO_SEED_EMAIL_DOMAIN=mileway.test
PORT=4000
NODE_ENV=development
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
SEED_ON_START=false
# Opt in only on an authorized development/test/demo service. Razorpay takes precedence when configured.
DEMO_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# SMTP transport URL including escaped credentials; no email service required for local demo.
SMTP_URL=
MAIL_FROM=
ALLOW_DEV_RESET_LOG=false
# Set NEXT_PUBLIC_API_ORIGIN in the Next build environment only for split-origin development.
# Single-service deployment uses a relative API URL.
